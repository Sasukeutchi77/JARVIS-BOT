# ╔══════════════════════════════════════════════════════╗
# ║          J.A.R.V.I.S — Configuration .env            ║
# ║                                                      ║
# ║  REMPLISSEZ CE FICHIER AVANT DE LANCER LE BOT        ║
# ║  Copiez ce fichier vers .env                         ║
# ║  Le bot refuse de démarrer si OWNER_NUMBER manque    ║
# ╚══════════════════════════════════════════════════════╝

# ══════════════════════════════════════════════════════
# ── OWNER (OBLIGATOIRE) ───────────────────────────────
# Numéro WhatsApp avec indicatif pays, sans + ni espaces
OWNER_NUMBER=VOTRE_NUMERO_SANS_PLUS
# Owners supplémentaires (optionnel, séparés par virgule)
OWNER_NUMBERS=
# LID WhatsApp de l'owner (optionnel, auto-détecté)
OWNER_LID=

# ══════════════════════════════════════════════════════
# ── SUDO (assistants du bot) ──────────────────────────
SUDO=

# ══════════════════════════════════════════════════════
# ── IDENTITÉ ET PARAMÈTRES DU BOT ─────────────────────
BOT_NAME=𝐉.𝐀.𝐑.𝐕.𝐈.𝐒
DEVELOPER_NAME=𝐋𝐎𝐑𝐃 𝐃𝐄𝐌𝐎𝐍
TEAM_NAME=𝐍𝐄𝐗𝐔𝐒-𝐅𝐎𝐑𝐆𝐄𝐑
PREFIX=.
MODE=public
TZ=Africa/Ouagadougou
BOT_CONNECT_LINK=

# ══════════════════════════════════════════════════════
# ── MODÉRATION ───────────────────────────────────────
MAX_WARNS=3
COOLDOWN_MS=2000
FLOOD_MAX=5
FLOOD_WINDOW=5000

# ══════════════════════════════════════════════════════
# ── REPORT / SIGNALEMENT ─────────────────────────────
REPORT_COOLDOWN_MS=10000
REPORT_BRIDGE_ENABLED=true

# ══════════════════════════════════════════════════════
# ── API IA — GROQ ────────────────────────────────────
CLE_GROQ=VOTRE_CLE_GROQ
GROQ_MODEL=openai/gpt-oss-120b

# ══════════════════════════════════════════════════════
# ── API IA — OPENAI ───────────────────────────────────
CLE_OPENAI=VOTRE_CLE_OPENAI
OPENAI_MODEL=gpt-4o-mini

# ══════════════════════════════════════════════════════
# ── API IA — GEMINI ───────────────────────────────────
CLE_GEMINI=VOTRE_CLE_GEMINI
GEMINI_MODEL=gemini-2.0-flash

# ══════════════════════════════════════════════════════
# ── API TELEGRAM ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_TELEGRAM

# ══════════════════════════════════════════════════════
# ── APIs OPTIONNELLES ─────────────────────────────────
PIXABAY_KEY=
OPENWEATHER_KEY=
OCR_API_KEY=
DEEPGRAM_KEY=

# ══════════════════════════════════════════════════════
# ── COMPORTEMENT ──────────────────────────────────────
AUTO_READ=true
AUTO_TYPING=true

# ══════════════════════════════════════════════════════
# ── SECRET DE SESSION ─────────────────────────────────
# Remplacez par une chaîne aléatoire longue (40+ caractères)
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG
